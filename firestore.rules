rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@orono[.]k12[.]mn[.]us');
    }

    function isSelf(offboardingId) {
      return isAuthed() && request.auth.uid == offboardingId;
    }

    function isItAdmin() {
      return isAuthed() && request.auth.token.it_admin == true;
    }

    // Tech branch: IT support sees offboarding checklists (to work help
    // requests and device/account tasks) but never HR personnel data.
    function isTech() {
      return isItAdmin() || (isAuthed() && request.auth.token.it_support == true);
    }

    // hr claim is 'admin' | 'staff' (legacy grants used `true` = admin level).
    function isHR() {
      return isAuthed()
        && (request.auth.token.hr == true
            || request.auth.token.hr == 'admin'
            || request.auth.token.hr == 'staff'
            || request.auth.token.it_admin == true);
    }

    // Offboarding records. Document ID == user's Firebase UID, so rules
    // authorize by path — which also lets the client distinguish
    // "doesn't exist yet" from "denied" for first-time users.
    // All writes go through Cloud Functions for validation + audit.
    match /offboardings/{offboardingId} {
      allow read: if isSelf(offboardingId) || isTech();
      allow write: if false;

      match /fileScan/{fileId} {
        allow read: if isSelf(offboardingId) || isTech();
        allow write: if false;
      }

      match /auditLog/{logId} {
        allow read: if isSelf(offboardingId) || isTech();
        allow write: if false;
      }
    }

    // Successor lookup cache — any authed domain user can read.
    match /successors/{email} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // Staff roster synced from a spreadsheet via syncStaffRoster.
    // Any authed domain user can read for the person picker; writes are
    // server-side only.
    match /staff/{email} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // App-wide settings IT admins can edit (e.g. EOY return date).
    // Authed users read so the SummerVacationResponderTask can pick up
    // the configured date; writes go through callables.
    match /appSettings/{key} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // Audit log for admin grant/revoke. IT admins can read; writes are
    // server-side only (via setAdminClaim callable).
    match /adminAudit/{id} {
      allow read: if isItAdmin();
      allow write: if false;
    }

    // HR form submissions. Submitters read their own; HR reads all.
    // All writes go through the submitForm/updateSubmissionStatus callables.
    match /submissions/{id} {
      allow read: if isHR() || (isAuthed() && resource.data.submitterUid == request.auth.uid);
      allow write: if false;
    }

    // HR employee database (Phase 2). HR/IT read only; every write goes
    // through the hr.ts / hrImport.ts callables.
    match /employees/{id} {
      allow read: if isHR();
      allow write: if false;

      match /history/{entryId} {
        allow read: if isHR();
        allow write: if false;
      }
    }

    // Onboarding / termination checklist records.
    match /processes/{id} {
      allow read: if isHR();
      allow write: if false;
    }

    // Leaves of absence — own collection (not folded into processes) so a
    // narrower claim can gate it later without a data migration. Reason
    // categories only; medical detail never lands here.
    match /leaves/{id} {
      allow read: if isHR();
      allow write: if false;
    }

    // Building / position / name / address change events.
    match /changes/{id} {
      allow read: if isHR();
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
