{
  "name": "functions",
  "description": "Cloud Functions for OPS Offboarding",
  "private": true,
  "scripts": {
    "build": "node copy-shared.mjs && tsc",
    "build:watch": "node copy-shared.mjs && tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.3.2",
    "googleapis": "^183.0.0",
    "nodemailer": "^10.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^6.0.3"
  }
}
